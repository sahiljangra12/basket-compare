# Copy this file to .env and fill in what you have. Anything left blank is skipped.
# With no keys at all, the app runs on clearly-labelled SAMPLE prices.

# Kroger Public API (free, self-service) — Harris Teeter store prices
# https://developer.kroger.com -> create account -> register app -> copy client ID/secret
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Walmart Affiliate API (free) — Walmart.com prices + affiliate links
# https://walmart.io -> sign up -> upload your public key -> note consumer ID + key version
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY_PATH=./keys/walmart_private_key.pem
WALMART_PUBLISHER_ID=

# Instacart Developer Platform (self-service keys) — order the basket at Giant, Aldi, Safeway...
# https://docs.instacart.com/developer_platform_api/
INSTACART_API_KEY=
INSTACART_ENV=development

# Amazon Associates tag — added to Amazon Fresh links (earns commission)
AMAZON_ASSOCIATE_TAG=

# Minutes a fetched price stays fresh before re-fetching
PRICE_TTL_MINUTES=180

# auto = sample data only when no live keys are set; on/off to force
DEMO_MODE=auto
